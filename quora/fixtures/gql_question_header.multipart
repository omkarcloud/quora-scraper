{"data": {"question": {"id": "UXVlc3Rpb25AMDoxMDk5MzE=", "viewerHasAnswered": false, "viewerHasDrafted": false, "viewerAnswer": null, "__typename": "Question", "qid": 109931, "title": "{\"sections\": [{\"spans\": [{\"text\": \"What is machine learning?\", \"modifiers\": {}}], \"indent\": 0, \"quoted\": false, \"type\": \"plain\", \"is_rtl\": false}]}", "debugInfo": "{}", "tribeItem": null, "viewer": {"user": null, "id": "Vmlld2VyQDA6MA==", "showJapanShareItems": false, "isAdminMode": false, "staticContent": {"title": "There is help", "contentQtextDocument": {"legacyJson": "{\"sections\": [{\"spans\": [{\"text\": \"Need Help? Contact a suicide hotline if you need someone to talk to. If you have a friend in need of help, please encourage that person to contact a suicide hotline as well.\", \"modifiers\": {}}], \"indent\": 0, \"quoted\": false, \"type\": \"plain\", \"is_rtl\": false}, {\"spans\": [{\"text\": \"Worldwide\", \"modifiers\": {}}], \"indent\": 0, \"quoted\": false, \"type\": \"unordered-list\", \"is_rtl\": false}, {\"spans\": [{\"text\": \"In general, if you're outside the US, numbers for your country are here: \", \"modifiers\": {}}, {\"text\": \"https://befrienders.org/find-support-now/\", \"modifiers\": {\"link\": {\"type\": \"url\", \"url\": \"https://befrienders.org/find-support-now/\"}}}, {\"text\": \".\", \"modifiers\": {}}], \"indent\": 1, \"quoted\": false, \"type\": \"unordered-list\", \"is_rtl\": false}, {\"spans\": [{\"text\": \"You can also e-mail \", \"modifiers\": {}}, {\"text\": \"jo@samaritans.org\", \"modifiers\": {\"link\": {\"type\": \"url\", \"url\": \"mailto:jo@samaritans.org\"}}}, {\"text\": \" to talk to someone or go to \", \"modifiers\": {}}, {\"text\": \"http://www.samaritans.org/how-we...\", \"modifiers\": {\"link\": {\"type\": \"url\", \"url\": \"http://www.samaritans.org/how-we-can-help-you/contact-us\"}}}, {\"text\": \" to speak with someone.\", \"modifiers\": {}}], \"indent\": 1, \"quoted\": false, \"type\": \"unordered-list\", \"is_rtl\": false}, {\"spans\": [{\"text\": \"United States\", \"modifiers\": {}}], \"indent\": 0, \"quoted\": false, \"type\": \"unordered-list\", \"is_rtl\": false}, {\"spans\": [{\"text\": \"Call the \", \"modifiers\": {}}, {\"text\": \"988 Suicide & Crisis Lifeline\", \"modifiers\": {\"link\": {\"type\": \"url\", \"url\": \"https://988lifeline.org/\"}}}, {\"text\": \" at 988.\", \"modifiers\": {}}], \"indent\": 1, \"quoted\": false, \"type\": \"unordered-list\", \"is_rtl\": false}, {\"spans\": [{\"text\": \"Para espa\u00f1ol, llame al 988.\", \"modifiers\": {}}], \"indent\": 1, \"quoted\": false, \"type\": \"unordered-list\", \"is_rtl\": false}, {\"spans\": [{\"text\": \"Canada\", \"modifiers\": {}}], \"indent\": 0, \"quoted\": false, \"type\": \"unordered-list\", \"is_rtl\": false}, {\"spans\": [{\"text\": \"Locate a crisis centre in your area at \", \"modifiers\": {}}, {\"text\": \"The Canadian Association for Suicide Prevention\", \"modifiers\": {\"link\": {\"type\": \"url\", \"url\": \"https://suicideprevention.ca/resources/#support-services\"}}}, {\"text\": \".\", \"modifiers\": {}}], \"indent\": 1, \"quoted\": false, \"type\": \"unordered-list\", \"is_rtl\": false}, {\"spans\": [{\"text\": \"For youth under 18, you can call the Kids Help line at 1-800-668-6868.\", \"modifiers\": {}}], \"indent\": 1, \"quoted\": false, \"type\": \"unordered-list\", \"is_rtl\": false}, {\"spans\": [{\"text\": \"India\", \"modifiers\": {}}], \"indent\": 0, \"quoted\": false, \"type\": \"unordered-list\", \"is_rtl\": false}, {\"spans\": [{\"text\": \"Visit \", \"modifiers\": {}}, {\"text\": \"AASRA\", \"modifiers\": {\"link\": {\"type\": \"url\", \"url\": \"http://www.aasra.info/\"}}}, {\"text\": \" or call their 24/7 helpline at +91-22-27546669 or +91-22-27546667.\", \"modifiers\": {}}], \"indent\": 1, \"quoted\": false, \"type\": \"unordered-list\", \"is_rtl\": false}, {\"spans\": [{\"text\": \"You can also e-mail \", \"modifiers\": {}}, {\"text\": \"aasrahelpline@yahoo.com\", \"modifiers\": {\"link\": {\"type\": \"url\", \"url\": \"mailto:aasrahelpline@yahoo.com\"}}}, {\"text\": \".\", \"modifiers\": {}}], \"indent\": 1, \"quoted\": false, \"type\": \"unordered-list\", \"is_rtl\": false}, {\"spans\": [{\"text\": \"UK\", \"modifiers\": {}}], \"indent\": 0, \"quoted\": false, \"type\": \"unordered-list\", \"is_rtl\": false}, {\"spans\": [{\"text\": \"Call the Samaritans at 116 123\", \"modifiers\": {}}], \"indent\": 1, \"quoted\": false, \"type\": \"unordered-list\", \"is_rtl\": false}, {\"spans\": [{\"text\": \"France\", \"modifiers\": {}}], \"indent\": 0, \"quoted\": false, \"type\": \"unordered-list\", \"is_rtl\": false}, {\"spans\": [{\"text\": \"Call SOS Help at (33) 01 46 21 46 46\", \"modifiers\": {}}], \"indent\": 1, \"quoted\": false, \"type\": \"unordered-list\", \"is_rtl\": false}, {\"spans\": [{\"text\": \"Australia\", \"modifiers\": {}}], \"indent\": 0, \"quoted\": false, \"type\": \"unordered-list\", \"is_rtl\": false}, {\"spans\": [{\"text\": \"Call Lifeline Australia at 13 11 14\", \"modifiers\": {}}], \"indent\": 1, \"quoted\": false, \"type\": \"unordered-list\", \"is_rtl\": false}]}", "id": "UXRleHREb2N1bWVudEAwOmJiODBiZmZkYzRjZGE0YWNlYTY2MTk5YzYwN2Y5ODI0"}, "staticContentType": "suicide_prevention_message", "internalUrl": "", "id": "U3RhdGljQ29udGVudEAwOnN1aWNpZGVfcHJldmVudGlvbl9tZXNzYWdl"}, "noteModernStandardArabic": false}, "isDeleted": false, "asker": {"__typename": "User", "uid": 229621, "id": "VXNlckAwOjIyOTYyMQ==", "isEmployee": false}, "url": "/What-is-machine-learning", "adHierarchyVariant": "aggressive", "viewerShouldShowWriteAnswer": true, "viewerCanDelete": false, "viewerMarkedAnswerLater": false, "viewerIsFollowing": false, "followerCount": 17, "viewerCantAnswer": false, "decanonicalizedAnswerCount": 30, "viewerCanEdit": false, "isLocked": false, "hasUserAddedAdultTopic": false, "hasUserAddedSelfHarmTopic": false, "numDisplayComments": 0, "viewerCommentDraft": null, "isUserLimitedDistro": false, "view